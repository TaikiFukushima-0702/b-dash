# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Single-user gate: only this email can sign in
ALLOWED_EMAIL=you@example.com

# MCP server bearer token (generate any random string, e.g. `openssl rand -hex 32`)
MCP_BEARER_TOKEN=replace-with-a-long-random-string

# App URL (used for absolute URLs / OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
